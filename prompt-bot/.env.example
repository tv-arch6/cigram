# انسخه إلى .env بجنب prompt.py وعبّي القيم. ملف .env ما ينرفع لـ git.
# توكن البوت من @BotFather (إذا انكشف قبل: /revoke وخذ جديد)
BOT_TOKEN=
# مفتاح OmniRoute (يتجدّد تلقائياً بموافقة المشرف إذا انتهى)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# آيديات أدمنية إضافيين، مفصولة بفاصلة (الأساسي ثابت داخل الملف)
ADMIN_IDS=

# الاستوديو الذكي (كلها اختيارية)
STUDIO_ON=1
STUDIO_BUDGET=120
STUDIO_CLARIFY_WAIT=75
