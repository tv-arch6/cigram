<activity
    android:name="com.Cigram.vid.CigramDiscoverActivity"
    android:exported="false"
    android:theme="@android:style/Theme.Material.NoActionBar" />

<activity
    android:name="com.Cigram.vid.AdvertiseActivity"
    android:exported="false"
    android:configChanges="orientation|screenSize|keyboardHidden|fontScale"
    android:theme="@android:style/Theme.Material.NoActionBar"
    android:windowSoftInputMode="adjustResize" />
<activity
    android:name="com.Cigram.vid.AdsChatActivity"
    android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|keyboard|uiMode"
    android:theme="@android:style/Theme.Material.NoActionBar"
    android:windowSoftInputMode="adjustResize" />
<activity
    android:name="com.Cigram.vid.MyAdsActivity"
    android:theme="@android:style/Theme.Material.NoActionBar"
