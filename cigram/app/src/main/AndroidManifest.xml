    android:windowSoftInputMode="adjustNothing" />
<service
    android:name="com.Cigram.vid.CigramFcmService"
    android:exported="false">
    <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
    </intent-filter>
</service>
<service
    android:name="com.Cigram.vid.CigramCastKeepAlive"
    android:exported="false"
    android:stopWithTask="false"
    android:foregroundServiceType="mediaPlayback" />
<activity
    android:name="com.Cigram.vid.CigramBannerActivity"
    android:exported="false"
