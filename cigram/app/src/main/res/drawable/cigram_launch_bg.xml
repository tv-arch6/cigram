<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen (every Android version): the theme's charcoal / light page with the rounded Cigram logo in the
     centre, drawn by the system from the very first frame of a cold start. Before 2026 this drawable had NO logo
     (only a maroon glow) and the Android 12+ splash icon was transparent, so a cold start showed an empty dark
     screen until MainActivity had built Home. The same logo at the same size is used by the Android 12+ system
     splash (cigram_splash_icon) and by the in-app hand-off overlay (CigramSplash), so the three are seamless. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/cg_launch_bg" />
    <item
        android:width="112dp"
        android:height="112dp"
        android:gravity="center"
        android:drawable="@drawable/cigram_logo" />
</layer-list>
