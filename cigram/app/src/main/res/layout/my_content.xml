<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear_my_content_root"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#121214"
		android:gravity="top"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear_my_content_header"
			android:layout_width="match_parent"
			android:layout_height="56dp"
			android:paddingLeft="12dp"
			android:paddingRight="12dp"
			android:background="#1D1D21"
			android:gravity="right|center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/textview_my_content_title"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:background="@android:color/transparent"
				android:gravity="right|center_vertical"
				android:text="محتوياتي"
				android:textSize="20sp"
				android:textColor="#FFFFFF"
				android:layout_weight="1" />
			<ImageView
				android:id="@+id/imageview_my_content_back"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:padding="8dp"
				android:src="@drawable/rrt"
				android:scaleType="centerInside"
				android:layout_gravity="right|center_vertical" />
		</LinearLayout>
		<ScrollView
			android:id="@+id/vscroll_my_content"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:background="#121214"
			android:layout_weight="1"
			android:scrollbars="none">
			<LinearLayout
				android:id="@+id/linear_my_content_body"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="12dp"
				android:paddingTop="12dp"
				android:paddingRight="12dp"
				android:paddingBottom="20dp"
				android:background="#121214"
				android:gravity="top"
				android:orientation="vertical">
				<TextView
					android:id="@+id/textview_continue_title"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="8dp"
					android:paddingTop="12dp"
					android:paddingRight="8dp"
					android:paddingBottom="8dp"
					android:gravity="right"
					android:text="اكمل المشاهدة"
					android:textSize="20sp"
					android:textColor="#FFFFFF" />
				<HorizontalScrollView
					android:id="@+id/hscroll_continue_watching"
					android:layout_width="match_parent"
					android:layout_height="216dp"
					android:padding="8dp"
					android:scrollbars="none">
					<LinearLayout
						android:id="@+id/linear_continue_watching"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:padding="4dp"
						android:gravity="right|center_vertical"
						android:orientation="horizontal" />
				</HorizontalScrollView>
				<TextView
					android:id="@+id/textview_favorites_title"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="8dp"
					android:paddingTop="12dp"
					android:paddingRight="8dp"
					android:paddingBottom="8dp"
					android:gravity="right"
					android:text="المفضلة"
					android:textSize="20sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF" />
				<HorizontalScrollView
					android:id="@+id/hscroll_favorites"
					android:layout_width="match_parent"
					android:layout_height="258dp"
					android:padding="8dp"
					android:scrollbars="none">
					<LinearLayout
						android:id="@+id/linear_favorites"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:padding="4dp"
						android:gravity="right|center_vertical"
						android:orientation="horizontal" />
				</HorizontalScrollView>
				<TextView
					android:id="@+id/textview_my_list_title"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="8dp"
					android:paddingTop="12dp"
					android:paddingRight="8dp"
					android:paddingBottom="8dp"
					android:gravity="right"
					android:text="قائمتي"
					android:textSize="20sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF" />
				<HorizontalScrollView
					android:id="@+id/hscroll_my_list"
					android:layout_width="match_parent"
					android:layout_height="258dp"
					android:padding="8dp"
					android:scrollbars="none">
					<LinearLayout
						android:id="@+id/linear_my_list"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:padding="4dp"
						android:gravity="right|center_vertical"
						android:orientation="horizontal" />
				</HorizontalScrollView>
				<LinearLayout
					android:id="@+id/linear_ads_toolbar"
					android:layout_width="1dp"
					android:layout_height="1dp"
					android:padding="8dp"
					android:orientation="horizontal" />
				<TextView
					android:id="@+id/textview_ads_title"
					android:layout_width="1dp"
					android:layout_height="1dp"
					android:padding="8dp"
					android:text="TextView"
					android:textSize="12sp" />
				<ImageView
					android:id="@+id/img_ads_back"
					android:layout_width="1dp"
					android:layout_height="1dp"
					android:src="@drawable/default_image"
					android:scaleType="center" />
			</LinearLayout>
		</ScrollView>
	</LinearLayout>
</LinearLayout>
