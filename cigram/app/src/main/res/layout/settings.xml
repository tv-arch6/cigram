<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear_settings_root"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#0B1F2A"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear_settings_toolbar"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:padding="12dp"
			android:background="#0B2A38"
			android:gravity="right|center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/textview_settings_title"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:gravity="right|center_vertical"
				android:text="الاعدادات"
				android:textSize="20sp"
				android:textColor="#FFFFFF"
				android:layout_weight="1" />
			<ImageView
				android:id="@+id/img_settings_back"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:layout_marginLeft="8dp"
				android:padding="8dp"
				android:src="@drawable/rrt"
				android:scaleType="centerInside"
				android:layout_gravity="right|center_vertical" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear_settings_content"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp"
			android:background="#102330"
			android:orientation="vertical">
			<TextView
				android:id="@+id/textview_account_section"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:gravity="right"
				android:text="الحساب"
				android:textSize="20sp"
				android:textColor="#FFFFFF" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear3"
			android:layout_width="match_parent"
			android:layout_height="90dp"
			android:orientation="horizontal">
			<de.hdodenhof.circleimageview.CircleImageView
				android:id="@+id/circleimageview_profile_avatar"
				android:layout_width="64dp"
				android:layout_height="64dp"
				android:src="@drawable/afu"
				android:clickable="false"
				app:civ_border_width="0dp"
				app:civ_border_color="@android:color/transparent"
				app:civ_circle_background_color="@android:color/transparent"
				app:civ_border_overlay="false" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear_settings_account_card"
			android:layout_width="match_parent"
			android:layout_height="58dp"
			android:background="#0B2936"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear_settings_edit_profile"
				android:layout_width="match_parent"
				android:layout_height="58dp"
				android:padding="8dp"
				android:background="@android:color/transparent"
				android:gravity="right|center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textview_settings_edit_profile"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:background="@android:color/transparent"
					android:gravity="right|center_vertical"
					android:text="تعديل الحساب "
					android:textSize="14sp"
					android:textColor="#FFFFFF" />
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear_settings_delete_avatar"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:padding="16dp"
			android:background="@android:color/transparent"
			android:gravity="right|center_vertical"
			android:orientation="horizontal"
			android:enabled="false"
			android:clickable="false">
			<TextView
				android:id="@+id/textview_settings_delete_avatar"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="@android:color/transparent"
				android:gravity="right|center_vertical"
				android:text="حذف صورة الحساب"
				android:textSize="14sp"
				android:textColor="#FFFFFF"
				android:enabled="false"
				android:clickable="false"
				android:alpha="0.0" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear_settings_logout"
			android:layout_width="match_parent"
			android:layout_height="58dp"
			android:padding="16dp"
			android:background="@android:color/transparent"
			android:gravity="right|center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/textview_settings_logout"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="@android:color/transparent"
				android:gravity="right|center_vertical"
				android:text="تسجيل الخروج"
				android:textSize="14sp"
				android:textColor="#FFFFFF" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp"
			android:background="#102330"
			android:orientation="vertical">
			<TextView
				android:id="@+id/textview_danger_section"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:gravity="right"
				android:text="منطقة الخطر"
				android:textSize="20sp"
				android:textColor="#FFFFFF" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="58dp"
			android:padding="16dp"
			android:background="@android:color/transparent"
			android:gravity="right|center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/textview_settings_delete_account"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="right|center_vertical"
				android:text="حذف الحساب بشكل نهائي"
				android:textSize="14sp"
				android:textColor="#F44336" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
