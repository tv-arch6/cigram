<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<ScrollView
		android:id="@+id/vscroll_account"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#111113"
		android:scrollbars="none">
		<LinearLayout
			android:id="@+id/linear_account_content"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="35dp"
			android:paddingBottom="110dp"
			android:background="#0E0E10"
			android:gravity="center_horizontal"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear_guest_account"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="24dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical">
				<TextView
					android:id="@+id/textview_guest_welcome"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="أهلاً، ليس لديك حساب؟"
					android:textSize="20sp"
					android:textColor="#FFFFFF" />
				<TextView
					android:id="@+id/textview_guest_hint"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="سجل دخولك معنا عبر:"
					android:textSize="14sp"
					android:textColor="#CCCCCC" />
				<Button
					android:id="@+id/button_open_login"
					android:layout_width="220dp"
					android:layout_height="52dp"
					android:padding="8dp"
					android:background="#FFFFFF"
					android:gravity="center_horizontal|center_vertical"
					android:text="تسجيل الدخول"
					android:textSize="17sp"
					android:textColor="#000000" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear_auth_tabs"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:layout_marginLeft="16dp"
				android:layout_marginRight="16dp"
				android:layout_marginBottom="24dp"
				android:padding="4dp"
				android:background="#1D1D20"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textview_register_tab"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="تسجيل (ليس لديك حساب)"
					android:textSize="15sp"
					android:textStyle="bold"
					android:textColor="#8A8A8F"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/textview_login_tab"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="تسجيل الدخول (مسجل مسبقاً)"
					android:textSize="15sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:layout_weight="1" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear_login_form"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="16dp"
				android:layout_marginTop="8dp"
				android:layout_marginRight="16dp"
				android:paddingLeft="16dp"
				android:paddingTop="8dp"
				android:paddingRight="16dp"
				android:paddingBottom="8dp"
				android:gravity="center_horizontal"
				android:orientation="vertical" />
			<EditText
				android:id="@+id/edittext_login_email"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:layout_marginBottom="12dp"
				android:padding="16dp"
				android:background="#1D1D20"
				android:gravity="right|center_vertical"
				android:textSize="15sp"
				android:textColor="#FFFFFF"
				android:hint="البريد الالكتروني"
				android:textColorHint="#8A8A8F" />
			<EditText
				android:id="@+id/edittext_login_password"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:layout_marginTop="12dp"
				android:padding="16dp"
				android:background="#1D1D20"
				android:gravity="right|center_vertical"
				android:textSize="12sp"
				android:textColor="#FFFFFF"
				android:hint="كلمة المرور"
				android:textColorHint="#8A8A8F"
				android:inputType="textPassword" />
			<TextView
				android:id="@+id/textview_forgot_password"
				android:layout_width="match_parent"
				android:layout_height="40dp"
				android:layout_marginTop="4dp"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="نسيت كلمة المرور؟"
				android:textSize="12sp"
				android:textColor="#9EADB5" />
			<Button
				android:id="@+id/button_login"
				android:layout_width="110dp"
				android:layout_height="46dp"
				android:layout_marginTop="12dp"
				android:layout_marginBottom="12dp"
				android:padding="8dp"
				android:background="#E91B1B"
				android:text="تسجيل الدخول"
				android:textSize="14sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />
			<LinearLayout
				android:id="@+id/linear_register_form"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="16dp"
				android:layout_marginTop="8dp"
				android:layout_marginRight="16dp"
				android:paddingLeft="16dp"
				android:paddingTop="16dp"
				android:paddingRight="8dp"
				android:paddingBottom="8dp"
				android:gravity="center_horizontal"
				android:orientation="vertical">
				<EditText
					android:id="@+id/edittext_register_name"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:padding="16dp"
					android:background="#1D1D20"
					android:gravity="right|center_vertical"
					android:textSize="15sp"
					android:textColor="#FFFFFF"
					android:hint="الاسم"
					android:textColorHint="#8A8A8F" />
				<EditText
					android:id="@+id/edittext_register_email"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:layout_marginTop="12dp"
					android:padding="16dp"
					android:background="#1D1D20"
					android:gravity="right|center_vertical"
					android:textSize="15sp"
					android:textColor="#FFFFFF"
					android:hint="البريد الالكتروني"
					android:textColorHint="#8A8A8F" />
				<EditText
					android:id="@+id/edittext_register_password"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:layout_marginTop="12dp"
					android:padding="16dp"
					android:background="#1D1D20"
					android:gravity="right|center_vertical"
					android:textSize="15sp"
					android:textColor="#FFFFFF"
					android:hint="كلمة المرور"
					android:textColorHint="#8A8A8F"
					android:inputType="textPassword" />
				<EditText
					android:id="@+id/edittext_register_confirm_password"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:layout_marginTop="12dp"
					android:padding="16dp"
					android:background="#1D1D20"
					android:gravity="right|center_vertical"
					android:textSize="15sp"
					android:textColor="#FFFFFF"
					android:hint="تأكيد كلمة المرور"
					android:textColorHint="#8A8A8F"
					android:inputType="textPassword" />
			</LinearLayout>
			<Button
				android:id="@+id/button_register"
				android:layout_width="110dp"
				android:layout_height="46dp"
				android:layout_marginTop="16dp"
				android:layout_marginBottom="16dp"
				android:padding="8dp"
				android:background="#E91B1B"
				android:text="انشاء الحساب"
				android:textSize="14sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />
			<LinearLayout
				android:id="@+id/linear_profile"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@android:color/transparent"
				android:gravity="center_horizontal"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear_profile_avatar_row"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="12dp"
					android:background="#1C1C20"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical">
					<de.hdodenhof.circleimageview.CircleImageView
						android:id="@+id/circleimageview_profile_avatar"
						android:layout_width="85dp"
						android:layout_height="85dp"
						android:src="@drawable/afu"
						android:clickable="false"
						app:civ_border_width="0dp"
						app:civ_border_color="@android:color/transparent"
						app:civ_circle_background_color="@android:color/transparent"
						app:civ_border_overlay="false" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear_profile_info"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:background="#1C1C20"
					android:gravity="right"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview_profile_username_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="right"
						android:text="اسم المستخدم :"
						android:textSize="15sp"
						android:textColor="#FFFFFF" />
					<TextView
						android:id="@+id/textview_profile_gender_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="right"
						android:text="الجنس :"
						android:textSize="15sp"
						android:textColor="#FFFFFF" />
					<TextView
						android:id="@+id/textview_profile_email_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="right"
						android:text="البريد الالكتروني :"
						android:textSize="15sp"
						android:textColor="#FFFFFF" />
				</LinearLayout>
				<TextView
					android:id="@+id/textview_profile_name"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="اسم المستخدم"
					android:textSize="12sp"
					android:textColor="#FFFFFF" />
				<TextView
					android:id="@+id/textview_profile_email"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="البريد الإلكتروني"
					android:textSize="12sp"
					android:textColor="#FFFFFF" />
				<LinearLayout
					android:id="@+id/linear_gender"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="horizontal">
					<Button
						android:id="@+id/button_gender_female"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:text="انثى"
						android:textSize="12sp"
						android:textColor="#FFFFFF" />
					<Button
						android:id="@+id/button_gender_male"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:text="ذكر"
						android:textSize="12sp"
						android:textColor="#FFFFFF" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear_account_settings"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:background="#0E0E10"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/img_account_settings_arrow"
						android:layout_width="28dp"
						android:layout_height="28dp"
						android:src="@drawable/hsi"
						android:scaleType="centerInside" />
					<TextView
						android:id="@+id/textview1"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="center_vertical"
						android:text="الاعدادات"
						android:textSize="14sp"
						android:textColor="#FFFFFF" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear_account_subtitle_font"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:background="#0E0E10"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/img_account_subtitle_font_arrow"
					android:layout_width="28dp"
					android:layout_height="28dp"
					android:src="@drawable/hsi"
					android:scaleType="centerInside" />
				<TextView
					android:id="@+id/textview_account_subtitle_font"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:gravity="center_vertical"
					android:text="خطوطي"
					android:textSize="14sp"
					android:textColor="#FFFFFF" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear_my_content"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:background="#0E0E10"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/imageview4"
					android:layout_width="28dp"
					android:layout_height="28dp"
					android:src="@drawable/hsi"
					android:scaleType="centerInside" />
				<TextView
					android:id="@+id/textview4"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:background="@android:color/transparent"
					android:gravity="center_vertical"
					android:text="محتوياتي"
					android:textSize="14sp"
					android:textColor="#FFFFFF" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear_help_support"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:background="#0E0E10"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/imageview1"
					android:layout_width="28dp"
					android:layout_height="28dp"
					android:src="@drawable/hsi"
					android:scaleType="centerInside" />
				<TextView
					android:id="@+id/ads"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:background="@android:color/transparent"
					android:gravity="center_vertical"
					android:text="المساعدة والدعم"
					android:textSize="14sp"
					android:textColor="#FFFFFF" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
