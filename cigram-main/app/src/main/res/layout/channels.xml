<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear_channels_root"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#1C1C20"
		android:orientation="vertical"
		android:layoutDirection="rtl">
		<LinearLayout
			android:id="@+id/linear_my_content_header"
			android:layout_width="match_parent"
			android:layout_height="56dp"
			android:paddingLeft="12dp"
			android:paddingRight="12dp"
			android:background="#1D1D21"
			android:gravity="right|center_vertical"
			android:orientation="horizontal"
			android:layoutDirection="ltr">
			<TextView
				android:id="@+id/textview_my_content_title"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:background="@android:color/transparent"
				android:gravity="right|center_vertical"
				android:text="القنوات"
				android:textSize="20sp"
				android:textColor="#FFFFFF"
				android:layout_weight="1"
				android:layoutDirection="rtl"
				android:textDirection="rtl"
				android:textAlignment="viewEnd" />
			<ImageView
				android:id="@+id/imageview_my_content_back"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:padding="8dp"
				android:background="@android:color/transparent"
				android:src="@drawable/rrt"
				android:scaleType="centerInside"
				android:layout_gravity="right|center_vertical" />
		</LinearLayout>
		<TextView
			android:id="@+id/textview_sports_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:background="#1C1C20"
			android:gravity="right"
			android:text="الرياضة"
			android:textSize="22sp"
			android:textColor="#FFFFFF"
			android:layoutDirection="rtl"
			android:textDirection="rtl"
			android:textAlignment="viewEnd" />
		<HorizontalScrollView
			android:id="@+id/scroll_sports"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:scrollbars="none"
			android:layoutDirection="ltr">
			<LinearLayout
				android:id="@+id/linear_sports_channels"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="5dp"
				android:gravity="right|center_vertical"
				android:orientation="horizontal"
				android:layoutDirection="rtl">
				<androidx.cardview.widget.CardView
					android:id="@+id/card_bein3"
					android:layout_width="140dp"
					android:layout_height="wrap_content"
					app:contentPadding="8dp"
					app:cardElevation="0dp"
					app:cardCornerRadius="16dp"
					app:cardBackgroundColor="#66000000">
					<LinearLayout
						android:id="@+id/linear_bein3"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:background="@android:color/transparent"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical">
						<ImageView
							android:id="@+id/image_bein3"
							android:layout_width="130dp"
							android:layout_height="85dp"
							android:src="@drawable/yyy"
							android:scaleType="centerCrop" />
						<TextView
							android:id="@+id/text_bein3"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:background="@android:color/transparent"
							android:gravity="center_horizontal|center_vertical"
							android:text="beIN SPORTS 3"
							android:textSize="16sp"
							android:textColor="#FFFFFF" />
					</LinearLayout>
				</androidx.cardview.widget.CardView>
			</LinearLayout>
		</HorizontalScrollView>
		<TextView
			android:id="@+id/textview6"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:background="#1C1C20"
			android:gravity="right"
			android:text="الأخبارية"
			android:textSize="22sp"
			android:textColor="#FFFFFF"
			android:layoutDirection="rtl"
			android:textDirection="rtl"
			android:textAlignment="viewEnd" />
		<HorizontalScrollView
			android:id="@+id/hscroll2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:scrollbars="none"
			android:layoutDirection="ltr">
			<LinearLayout
				android:id="@+id/linear7"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="5dp"
				android:gravity="right|center_vertical"
				android:orientation="horizontal"
				android:layoutDirection="rtl">
				<androidx.cardview.widget.CardView
					android:id="@+id/cardview2"
					android:layout_width="140dp"
					android:layout_height="wrap_content"
					app:contentPadding="8dp"
					app:cardElevation="0dp"
					app:cardCornerRadius="16dp"
					app:cardBackgroundColor="#66000000">
					<LinearLayout
						android:id="@+id/linear3"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:background="@android:color/transparent"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical">
						<ImageView
							android:id="@+id/imageview3"
							android:layout_width="130dp"
							android:layout_height="85dp"
							android:src="@drawable/channels4_profile"
							android:scaleType="centerCrop" />
						<TextView
							android:id="@+id/textview3"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:background="@android:color/transparent"
							android:gravity="center_horizontal|center_vertical"
							android:text="الشرقية"
							android:textSize="16sp"
							android:textColor="#FFFFFF"
							android:textDirection="rtl" />
					</LinearLayout>
				</androidx.cardview.widget.CardView>
			</LinearLayout>
		</HorizontalScrollView>
	</LinearLayout>
</LinearLayout>
