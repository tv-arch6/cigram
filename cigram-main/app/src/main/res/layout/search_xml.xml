<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<ScrollView
		android:id="@+id/vscroll1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#111113"
		android:scrollbars="none">
		<LinearLayout
			android:id="@+id/linear_root_search"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="#1A1A1D"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear_search_top"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:paddingLeft="10dp"
				android:paddingRight="10dp"
				android:background="#1A1A1D"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal|center_vertical">
				<ImageView
					android:id="@+id/imageview_voice"
					android:layout_width="35dp"
					android:layout_height="35dp"
					android:src="@drawable/icon_mic_none_round"
					android:scaleType="centerCrop"
					android:layout_gravity="left|center_vertical" />
				<EditText
					android:id="@+id/edittext_search"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:background="@android:color/transparent"
					android:gravity="right|center_vertical"
					android:textSize="15sp"
					android:textColor="#FFFFFF"
					android:hint="ابحث عن أفلام، مسلسلات"
					android:textColorHint="#707980"
					android:layout_weight="1" />
				<ImageView
					android:id="@+id/imageview_search_icon"
					android:layout_width="35dp"
					android:layout_height="35dp"
					android:src="@drawable/icon_search_round"
					android:scaleType="centerCrop" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear_search_controls"
				android:layout_width="match_parent"
				android:layout_height="64dp"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear_filter_box"
					android:layout_width="46dp"
					android:layout_height="46dp"
					android:layout_marginLeft="8dp"
					android:layout_marginTop="16dp"
					android:layout_marginRight="4dp"
					android:background="#1C1C20"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_gravity="left">
					<ImageView
						android:id="@+id/imageview_filter"
						android:layout_width="30dp"
						android:layout_height="30dp"
						android:src="@drawable/mic_2"
						android:scaleType="centerInside" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear_search_tabs"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:padding="8dp"
					android:background="@android:color/transparent"
					android:gravity="right|center_vertical"
					android:orientation="horizontal"
					android:layout_weight="1">
					<TextView
						android:id="@+id/textview_tab_series"
						android:layout_width="0dp"
						android:layout_height="44dp"
						android:layout_marginLeft="3dp"
						android:layout_marginRight="3dp"
						android:padding="8dp"
						android:background="@android:color/transparent"
						android:gravity="center_horizontal|center_vertical"
						android:text="مسلسلات"
						android:textSize="14sp"
						android:textColor="#FFFFFF"
						android:layout_weight="1" />
					<TextView
						android:id="@+id/textview_tab_movies"
						android:layout_width="0dp"
						android:layout_height="44dp"
						android:layout_marginLeft="3dp"
						android:layout_marginRight="3dp"
						android:padding="8dp"
						android:background="@android:color/transparent"
						android:gravity="center_horizontal|center_vertical"
						android:text="افلام"
						android:textSize="14sp"
						android:textColor="#FFFFFF"
						android:layout_weight="1" />
					<TextView
						android:id="@+id/textview_tab_all"
						android:layout_width="0dp"
						android:layout_height="44dp"
						android:layout_marginLeft="3dp"
						android:layout_marginRight="3dp"
						android:padding="8dp"
						android:background="@android:color/transparent"
						android:gravity="center_horizontal|center_vertical"
						android:text="الكل"
						android:textSize="14sp"
						android:textColor="#FFFFFF"
						android:layout_weight="1" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear_search_empty"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:layout_gravity="center_horizontal|center_vertical">
				<ImageView
					android:id="@+id/imageview_empty_search"
					android:layout_width="90dp"
					android:layout_height="90dp"
					android:src="@drawable/search_1"
					android:scaleType="centerInside" />
				<TextView
					android:id="@+id/textview_empty_search"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="نتائج البحث ستظهر هنا"
					android:textSize="16sp"
					android:textColor="#707980" />
				<LinearLayout
					android:id="@+id/linear_search_results"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="12dp"
					android:paddingTop="8dp"
					android:paddingRight="12dp"
					android:paddingBottom="20dp"
					android:gravity="center_horizontal"
					android:orientation="vertical" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
