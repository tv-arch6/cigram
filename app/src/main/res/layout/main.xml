<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<ScrollView
		android:id="@+id/vscroll1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#00121A"
		android:fillViewport="true"
		android:overScrollMode="never"
		android:scrollbars="none">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear7"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="#05141F"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				layout_marginLeft="0"
				layout_marginStart="0"
				layout_marginEnd="0">
				<LinearLayout
					android:id="@+id/linear9"
					android:layout_width="56dp"
					android:layout_height="56dp"
					android:orientation="vertical"
					android:layout_gravity="left|center_vertical">
					<ImageView
						android:id="@+id/ball"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:layout_marginLeft="3dp"
						android:layout_marginTop="7dp"
						android:padding="8dp"
						android:src="@drawable/ic_notifications_white"
						android:scaleType="centerInside"
						android:layout_gravity="center_vertical" />
				</LinearLayout>
				<TextView
					android:id="@+id/textview4"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginRight="8dp"
					android:gravity="right|center_vertical"
					android:text="سيكرام"
					android:textSize="20sp"
					android:textColor="#FFFFFF"
					android:layout_gravity="right|center_vertical"
					android:layout_weight="1" />
				<ImageView
					android:id="@+id/imageview9"
					android:layout_width="30dp"
					android:layout_height="30dp"
					android:src="@drawable/hoo"
					android:scaleType="centerCrop"
					android:layout_gravity="right|center_vertical" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear_latest_movies_header"
				android:layout_width="match_parent"
				android:layout_height="52dp"
				android:paddingLeft="14dp"
				android:paddingRight="14dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textview_more_latest_movies"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:gravity="left|center_vertical"
					android:text="المزيد"
					android:textSize="16sp"
					android:textColor="#AAB4B9"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/textview_latest_movies_title"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:gravity="right|center_vertical"
					android:text="أحدث الأفلام "
					android:textSize="22sp"
					android:textColor="#FFFFFF" />
			</LinearLayout>
			<HorizontalScrollView
				android:id="@+id/hscroll1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="#00121A"
				android:scrollbars="none">
				<LinearLayout
					android:id="@+id/linear_movies"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_margin="8dp"
					android:background="#00121A"
					android:gravity="center_vertical"
					android:orientation="horizontal" />
			</HorizontalScrollView>
			<LinearLayout
				android:id="@+id/linear8"
				android:layout_width="match_parent"
				android:layout_height="52dp"
				android:paddingLeft="14dp"
				android:paddingRight="14dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textview_more_latest_series"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:gravity="left|center_vertical"
					android:text="المزيد"
					android:textSize="16sp"
					android:textColor="#AAB4B9"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/textview6"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:gravity="right|center_vertical"
					android:text="المسلسلات المميزة "
					android:textSize="22sp"
					android:textColor="#FFFFFF" />
			</LinearLayout>
			<HorizontalScrollView
				android:id="@+id/hscroll_series"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:background="#00121A"
				android:scrollbars="none">
				<LinearLayout
					android:id="@+id/linear_series"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:background="#00121A"
					android:gravity="center_vertical"
					android:orientation="horizontal" />
			</HorizontalScrollView>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
