<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear_communication_root"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#001B23"
		android:gravity="top"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear_communication_header"
			android:layout_width="match_parent"
			android:layout_height="56dp"
			android:paddingLeft="12dp"
			android:paddingRight="12dp"
			android:background="#0B2A38"
			android:gravity="right|center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/textview_communication_title"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:background="@android:color/transparent"
				android:gravity="right|center_vertical"
				android:text="تواصل معنا"
				android:textSize="20sp"
				android:textColor="#FFFFFF"
				android:layout_weight="1" />
			<ImageView
				android:id="@+id/imageview_communication_back"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:padding="8dp"
				android:src="@drawable/rrt"
				android:scaleType="centerInside"
				android:layout_gravity="right|center_vertical" />
		</LinearLayout>
		<ScrollView
			android:id="@+id/vscroll_communication"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:background="#001B23"
			android:layout_weight="1"
			android:scrollbars="none">
			<LinearLayout
				android:id="@+id/linear_communication_body"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="12dp"
				android:paddingTop="12dp"
				android:paddingRight="12dp"
				android:paddingBottom="20dp"
				android:background="#001B23"
				android:gravity="top"
				android:orientation="vertical" />
		</ScrollView>
	</LinearLayout>
</LinearLayout>
